{
  "schemaVersion": "1",
  "name": "erp-core",
  "version": "1.0.0",
  "description": "Core ERP com clean architecture, temporalidade, policies e rule sets.",
  "entryPoint": "index.ts",
  "philosophy": {
    "errorModel": "mixed",
    "observability": ["log-port", "metric-port", "trace-port"],
    "testStyle": "vitest-no-mocks-in-core",
    "externalDeps": ["zod"],
    "testDeps": ["vitest"]
  },
  "docs": {
    "context": "KIT_CONTEXT.md",
    "readme": "README.md"
  },
  "lint": {
    "nodenextImports": "off",
    "noBareAny": "warn",
    "noExternalImports": "error",
    "noUpwardImports": "error"
  },
  "exports": [
    "Entity",
    "ValueObject",
    "Rule",
    "RuleSet",
    "RuleSetError",
    "ValidationResult",
    "Policy",
    "PolicyDecision",
    "Timeline",
    "TimelineEntry",
    "allow",
    "deny"
  ],
  "changelog": [
    "1.0.0 - Registro inicial do boilerplate com primitives tipadas para import direto, CLI e fluxo full-control."
  ],
  "deprecated": false
}
