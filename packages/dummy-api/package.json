{
    "name": "@cullet/dummy-api",
    "version": "1.0.2",
    "description": "Kit de exemplo minimo: esqueleto de core em clean architecture (camadas domain, application, errors e result) como referencia de estrutura para novos kits.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fabiano-eduardo/cullet.git",
        "directory": "packages/dummy-api"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown --config tsdown.config.ts",
        "dev": "tsdown --config tsdown.config.ts --watch"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.spec.ts",
        "!src/**/*.test.ts",
        "meta.json",
        "KIT_CONTEXT.md",
        "README.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.17"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT"
}
