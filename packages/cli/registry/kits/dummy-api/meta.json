{
    "schemaVersion": "2",
    "name": "dummy-api",
    "version": "1.0.2",
    "description": "Kit de exemplo minimo: esqueleto de core em clean architecture (camadas domain, application, errors e result) como referencia de estrutura para novos kits.",
    "compatibility": {
        "engines": {
            "node": ">=18",
            "typescript": ">=5.0.0"
        },
        "directImport": {
            "peerDependencies": []
        },
        "fullControl": {
            "dependencies": []
        }
    },
    "entryPoint": "index.ts",
    "philosophy": {
        "errorModel": "mixed",
        "observability": [],
        "testStyle": "vitest-no-mocks-in-core",
        "externalDeps": [],
        "testDeps": ["vitest"]
    },
    "docs": {
        "context": "KIT_CONTEXT.md",
        "readme": "README.md"
    },
    "lint": {
        "nodenextImports": "warn",
        "noBareAny": "warn",
        "noExternalImports": "error",
        "noUpwardImports": "error"
    },
    "exports": [],
    "changelog": ["1.0.0 - Initial scaffold."],
    "deprecated": false
}
