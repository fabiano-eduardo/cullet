{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "cli/**/*.ts",
    "kits/**/*.ts",
    "registry/**/*.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
